APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/product/new_product/drms/drms-saas/main_file/

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

AI_FOLDER_SEARCH_URL=http://127.0.0.1:5000

# Digital File Request (DFR) — digital access workflow
# Absolute path to the network/server folder where raw scanned files live
DFR_RAW_FOLDER_PATH=
# Number of working days (Mon–Fri) before a granted digital access expires
DFR_ACCESS_DAYS=5

# SMS Management (System Admin) - the names a message arrives under on a handset.
# Every one of these has a working default, so leaving them unset changes nothing;
# they are here only so a sender can be renamed without a code change.
# KLAES_SMS_SENDER_STAFF=KLAES
# KLAES_SMS_SENDER_DEPARTMENT=KANOMLPP
# KLAES_SMS_SENDER_KANGIS=KANGIS
#
# Which of those Bulk-SMS.ng has actually registered. Group keys or sender IDs,
# comma separated. Display only - it drives the warning on the SMS Management
# page and blocks nothing. An UNREGISTERED sender is accepted and BILLED by the
# gateway and then delivered to nobody, so only list a name the vendor has
# confirmed. Default: staff,department
# KLAES_SMS_REGISTERED_SENDERS=staff,department

# BetaSMS — Special Assignment contravention notices (first / second serve)
BETASMS_USERNAME=
BETASMS_PASSWORD=
BETASMS_SENDER=KLASE

# Create File Index -> "Fill demo data" button (TEST AID, off by default).
# Loads a REAL still-unindexed grouping row (genuine file number + tracking ID)
# and pads the human fields with invented local sample data.
# Ignored entirely when APP_ENV=production - that lock cannot be overridden here.
FILEINDEX_DEMO_FILL=false
# FILEINDEX_DEMO_FILL_REGISTRY="Lands Registry"
# FILEINDEX_DEMO_FILL_LAND_USE=INDUSTRIAL
