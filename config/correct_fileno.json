    "normalization_algorithm": {
      "step_1": "Trim leading/trailing whitespace",
      "step_2": "Convert to uppercase",
      "step_3":  "Fix OCR errors:  Replace C0N→CON, C0M→COM (zero to letter O)",
      "step_4": "Fix spelling errors: Replace RRES→RES, CM→COM, CN→CON",
      "step_5": "Replace non-hyphen delimiters (/, _, .) with hyphens",
      "step_6":  "Remove spaces around hyphens",
      "step_7": "Parse components (category, year, sequence)",
      "step_8": "Normalize year:  if < 100, convert (00-25 → 2000-2025, 81-99 → 1981-1999)",
      "step_9": "Remove leading zeros from sequence number",
      "step_10": "Validate:  year in range 1981-2025, category is valid, sequence > 0",
      "step_11": "Reconstruct as {CATEGORY}-{YEAR}-{SEQUENCE}"
    },
    
    "ocr_character_substitutions": {
      "description": "Common character substitutions for OCR error correction",
      "substitutions": [
        {
          "pattern": "C0N",
          "replacement": "CON",
          "reason": "Zero (0) misread as letter O"
        },
        {
          "pattern":  "C0M",
          "replacement": "COM",
          "reason": "Zero (0) misread as letter O"
        },
        {
          "pattern":  "RRES",
          "replacement": "RES",
          "reason": "Double R typo"
        },
        {
          "pattern": "CM-",
          "replacement": "COM-",
          "reason": "Missing O in COM",
          "context": "When followed by hyphen or RC"
        },
        {
          "pattern": "CN-",
          "replacement": "CON-",
          "reason": "Missing O in CON",
          "context": "When followed by land use type"
        },
        {
          "pattern": "AV-",
          "replacement": "AG-",
          "reason": "Letter V mistaken for G in AG prefixes"
        },
        {
          "pattern": "AV-RC",
          "replacement": "AG-RC",
          "reason": "Letter V mistaken for G in AG-RC prefixes"
        },
        {
          "pattern": "OPCON-",
          "replacement": "CON-",
          "reason": "Extraneous characters inserted before CON prefix"
        }
      ]
    }
